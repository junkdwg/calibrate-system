# Copy to .env and fill in. NEVER commit .env.
DJANGO_SECRET_KEY=change-me-use-generate-command-in-README
DJANGO_ALLOWED_HOSTS=calib.company.local,192.168.1.50
DJANGO_CSRF_TRUSTED_ORIGINS=https://calib.company.local,https://192.168.1.50
POSTGRES_DB=calibration
POSTGRES_USER=calib
POSTGRES_PASSWORD=change-me-too
# Default pass/fail tolerance for pH (+/-). PLACEHOLDER - confirm with QA.
DEFAULT_PH_TOLERANCE=0.05
# Reviewer/approver must differ from the calibrator
ENFORCE_SEGREGATION=true
# Max number of people allowed to enter data (group Technician)
MAX_DATA_ENTRY_USERS=2
# Days before due date to start warning
DUE_SOON_DAYS=30
